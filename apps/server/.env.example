NODE_ENV=production
PORT=4000
# 0.0.0.0 ile hem yerel ağdan (Wi-Fi) hem tünelden erişilir; sadece tünel için 127.0.0.1 yapabilirsiniz
HOST=0.0.0.0
# Üret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-with-48-byte-random-hex-secret-key-for-production
JWT_EXPIRES=30d
# İlk kullanıcı (yönetici) her zaman kayıt olabilir; sonrası için true yapın veya Admin panelinden yönetin
ALLOW_REGISTER=false
# Cloudflare Tunnel / Nginx arkasında true
TRUST_PROXY=true
MAX_UPLOAD_MB=4096
