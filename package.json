{
  "name": "nukedrive",
  "version": "0.1.0",
  "private": true,
  "description": "NukeDrive - Google Drive benzeri self-hosted dosya yönetimi (Web, Windows, macOS, Android)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace apps/server",
    "dev:web": "npm run dev --workspace apps/web",
    "build:web": "npm run build --workspace apps/web",
    "build:server": "npm run build --workspace apps/server",
    "build:desktop": "npm run build:apk && npm run build --workspace apps/desktop",
    "dev:desktop": "npm run dev --workspace apps/desktop",
    "build:apk": "powershell -ExecutionPolicy Bypass -File scripts/build-apk.ps1"
  },
  "engines": {
    "node": ">=20"
  }
}
